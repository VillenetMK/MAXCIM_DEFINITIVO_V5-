MAXCIM_MODE=simulation
MAXCIM_HOST=127.0.0.1
MAXCIM_PORT=8080
MAXCIM_DATABASE=var/team.db
MAXCIM_COOKIE_SECURE=false
MAXCIM_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ROS_DOMAIN_ID=42
# Modo físico: ROS 2 debe estar cargado y el gateway debe estar disponible.
# MAXCIM_MODE=ros2
# MAXCIM_COOKIE_SECURE=true al usar HTTPS.
# No escribir contraseñas ni claves reales en este archivo de ejemplo.
