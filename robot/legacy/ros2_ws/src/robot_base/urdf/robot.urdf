<?xml version="1.0"?>
<robot name="robot_base">
  <!-- Frame raíz / referencia del suelo -->
  <link name="base_footprint"/>
  <!-- Unión fija base_footprint -> base_link -->
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0.0 0.0 0.10" rpy="0 0 0"/>
  </joint>
  <!-- Centro del robot / Chasis -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.60 0.50 0.20"/>
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 0.8 1.0"/>
      </material>
    </visual>
  </link>
  <!-- Unión fija base_link -> laser (x: 0.10m, y: 0.0m, z: 0.20m) -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.10 0.0 0.20" rpy="0.0 0.0 0.0"/>
  </joint>
  <!-- Sensor RPLIDAR -->
  <link name="laser">
    <visual>
      <geometry>
        <cylinder length="0.04" radius="0.05"/>
      </geometry>
      <material name="black">
        <color rgba="0.1 0.1 0.1 1.0"/>
      </material>
    </visual>
  </link>
</robot>
